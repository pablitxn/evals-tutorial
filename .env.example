# Backend-only; copy to .env and supply an existing credential.
TUTORIAL_PROVIDER=openai
TUTORIAL_MODEL=
TUTORIAL_API_KEY=
# Azure requires its resource endpoint; Foundry project URLs are not accepted.
TUTORIAL_AZURE_ENDPOINT=
TUTORIAL_API_VERSION=
# Filled with a verified pinned image by ET-WP-00/ET-INTEGRATOR before G2.
PHOENIX_IMAGE=
PHOENIX_URL=http://127.0.0.1:6006
