# Backend-only; copy to .env and supply an existing credential.
TUTORIAL_PROVIDER=openai
TUTORIAL_MODEL=
TUTORIAL_API_KEY=
# Azure requires its resource endpoint; Foundry project URLs are not accepted.
TUTORIAL_AZURE_ENDPOINT=
TUTORIAL_API_VERSION=
# ET-WP-00 exercised this immutable image on Linux amd64.
PHOENIX_IMAGE=arizephoenix/phoenix:version-20.21.3@sha256:333ae941c99a366f90542cacfa5fa0745a331f13c2e66857de5e44c19a46f6e0
PHOENIX_URL=http://127.0.0.1:6006
# Empty provider/model/key values keep paid actions unavailable; Code fixtures still work.
# This file is parsed literally: shell-variable interpolation is not performed.
