    "CriterionResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "partial"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "criterionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      },
      "required": [
        "criterionId",
        "score",
        "label",
        "explanation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "fail"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 0
              }
            }
