{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evals-tutorial.local/contracts/v1.json",
  "title": "Evals Tutorial v1",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "ExerciseId": {
      "type": "string",
      "enum": [
        "intro",
        "01-starred-classifier",
        "02-document-classification",
        "03-independent-tie-out",
        "04-policy-recommendation",
        "05-package-readiness",
        "06-simulated-travel",
        "07-spec-regression"
      ]
    },
    "EvaluationMode": {
      "type": "string",
      "enum": [
        "Code",
        "LLM Judge",
        "Mixed"
      ]
    },
    "EvalResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "partial"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/CriterionResult"
          }
        }
      },
      "required": [
        "score",
        "label",
        "explanation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "fail"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      ]
    },
    "EvalInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/JsonObject"
        },
        "output": {
          "$ref": "#/$defs/JsonObject"
        },
        "expected": {
          "$ref": "#/$defs/JsonObject"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exampleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "exerciseId": {
              "$ref": "#/$defs/ExerciseId"
            },
            "datasetVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "exampleId",
            "exerciseId",
            "datasetVersion"
          ]
        }
      },
      "required": [
        "input",
        "output",
        "expected",
        "metadata"
      ]
    },
    "JudgeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rubric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "criterionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "maxItems": 12,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "rubric",
        "criterionIds"
      ]
    },
    "FixtureExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "partial"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "uniqueItems": true
        },
        "minScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requiredEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 16
        }
      },
      "required": [
        "allowedLabels",
        "minScore",
        "maxScore",
        "requiredEvidence"
      ]
    },
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "output": {
          "$ref": "#/$defs/JsonObject"
        },
        "expectedEvaluation": {
          "$ref": "#/$defs/FixtureExpectation"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "id",
        "output",
        "expectedEvaluation",
        "rationale"
      ]
    },
    "Example": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "input": {
          "$ref": "#/$defs/JsonObject"
        },
        "expected": {
          "$ref": "#/$defs/JsonObject"
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fixture"
          },
          "maxItems": 12,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "input",
        "expected",
        "metadata",
        "fixtures"
      ]
    },
    "DocumentManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^documents/[a-zA-Z0-9_/-]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "Dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "datasetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contentHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Example"
          },
          "maxItems": 16,
          "minItems": 1
        },
        "documentManifestRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentManifestRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "datasetId",
        "datasetVersion",
        "contentHash",
        "examples",
        "documentManifestRef"
      ]
    },
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^documents/[a-zA-Z0-9_/-]+\\.(png|jpg|jpeg|pdf)$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "application/pdf"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000
        },
        "pageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "maxItems": 12
        },
        "synthetic": {
          "const": true
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "mimeType",
        "bytes",
        "pageIds",
        "synthetic"
      ]
    },
    "DocumentManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "manifestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Document"
          },
          "maxItems": 24
        }
      },
      "required": [
        "schemaVersion",
        "manifestId",
        "version",
        "provenance",
        "documents"
      ]
    },
    "Criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "mode": {
          "$ref": "#/$defs/EvaluationMode"
        }
      },
      "required": [
        "id",
        "description",
        "mode"
      ]
    },
    "Exercise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ExerciseId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "exerciseVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rubricVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mode": {
          "$ref": "#/$defs/EvaluationMode"
        },
        "readOnly": {
          "type": "boolean"
        },
        "lessonMarkdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "starterSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "pythonSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "datasetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "datasetHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 12
        },
        "agentVariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "maxItems": 3
        },
        "defaultAgentVariant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "maxJudgeCallsPerRow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "inputSchema": {
          "$ref": "#/$defs/JsonObject"
        },
        "outputSchema": {
          "$ref": "#/$defs/JsonObject"
        },
        "expectedSchema": {
          "$ref": "#/$defs/JsonObject"
        },
        "officialDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https://"
              }
            },
            "required": [
              "title",
              "url"
            ]
          },
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "title",
        "exerciseVersion",
        "rubricVersion",
        "mode",
        "readOnly",
        "lessonMarkdown",
        "starterSource",
        "pythonSource",
        "datasetId",
        "datasetVersion",
        "datasetHash",
        "criteria",
        "agentVariants",
        "defaultAgentVariant",
        "maxJudgeCallsPerRow",
        "inputSchema",
        "outputSchema",
        "expectedSchema",
        "officialDocs"
      ]
    },
    "Tutorial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "tutorialVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "exercises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exercise"
          },
          "maxItems": 8,
          "minItems": 8
        }
      },
      "required": [
        "schemaVersion",
        "tutorialVersion",
        "title",
        "exercises"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "const": "evaluator.ts"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "code",
        "severity",
        "message"
      ]
    },
    "SourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tutorialVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "exerciseId": {
          "$ref": "#/$defs/ExerciseId"
        },
        "exerciseVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rubricVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "datasetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "datasetHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "tutorialVersion",
        "exerciseId",
        "exerciseVersion",
        "rubricVersion",
        "datasetId",
        "datasetVersion",
        "datasetHash",
        "source"
      ]
    },
    "ValidateRequest": {
      "$ref": "#/$defs/SourceSnapshot"
    },
    "ValidationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codeHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "valid": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "maxItems": 100
        }
      },
      "required": [
        "codeHash",
        "valid",
        "diagnostics"
      ]
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "snapshot": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixtures",
            "agent"
          ]
        },
        "agentVariant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      },
      "required": [
        "requestId",
        "snapshot",
        "mode",
        "agentVariant"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "not_found",
        "not_implemented",
        "configuration",
        "source_stale",
        "validation_failed",
        "isolation_unavailable",
        "runtime_error",
        "resource_limit",
        "protocol_error",
        "budget_exceeded",
        "provider_unavailable",
        "provider_refusal",
        "agent_output_schema",
        "unsupported_media",
        "timeout",
        "cancelled",
        "telemetry_unavailable",
        "review_ineligible",
        "review_output_schema",
        "conflict",
        "internal_error"
      ]
    },
    "OperationError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/OperationError"
        }
      },
      "required": [
        "error"
      ]
    },
    "ProviderSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "azure_foundry"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "configured": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "configRevision",
        "configured"
      ]
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "available"
      ]
    },
    "ServiceStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "phase": {
          "type": "string",
          "enum": [
            "foundation",
            "integrated"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/Capability"
            },
            "validation": {
              "$ref": "#/$defs/Capability"
            },
            "runner": {
              "$ref": "#/$defs/Capability"
            },
            "agents": {
              "$ref": "#/$defs/Capability"
            },
            "judge": {
              "$ref": "#/$defs/Capability"
            },
            "telemetry": {
              "$ref": "#/$defs/Capability"
            },
            "review": {
              "$ref": "#/$defs/Capability"
            }
          },
          "required": [
            "content",
            "validation",
            "runner",
            "agents",
            "judge",
            "telemetry",
            "review"
          ]
        },
        "automaticInference": {
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "phase",
        "provider",
        "capabilities",
        "automaticInference"
      ]
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
