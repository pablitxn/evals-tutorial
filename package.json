{
  "name": "evals-tutorial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/contracts",
    "packages/evaluator-runtime",
    "packages/phoenix",
    "packages/review"
  ],
  "scripts": {
    "contracts:generate": "python3 scripts/generate-contracts.py && node scripts/generate-validators.mjs",
    "contracts:check": "python3 scripts/generate-contracts.py --check && node scripts/generate-validators.mjs --check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && npm run typecheck:content",
    "test": "node scripts/test.mjs",
    "install:all": "node scripts/install-all.mjs",
    "env:check": "node --import tsx scripts/env-check.ts",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "package:source": "python3 scripts/package-source.py",
    "typecheck:content": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck --esModuleInterop --resolveJsonModule content/authoring/*.ts content/intro/starter.ts content/exercises/*/starter.ts tests/integration/*.test.ts",
    "test:python": ".venv/bin/python -m unittest discover -s apps/agents/tests -v",
    "test:docker": "node scripts/test-docker.mjs",
    "telemetry:retry": "node scripts/record-telemetry.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
